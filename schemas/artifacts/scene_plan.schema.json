{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scene_plan.schema.json",
  "title": "Scene plan",
  "description": "Stage contract shape only. Type-specific cut fields (text, color, particleCount, ...) are strictly validated by composer/src/schema.ts's zod schema at render time -- duplicating every field constraint here would just be two sources of truth to keep in sync.",
  "type": "object",
  "required": ["fps", "width", "height", "cuts"],
  "properties": {
    "fps": { "type": "integer", "exclusiveMinimum": 0 },
    "width": { "type": "integer", "exclusiveMinimum": 0 },
    "height": { "type": "integer", "exclusiveMinimum": 0 },
    "cuts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "durationInFrames"],
        "properties": {
          "type": {
            "enum": ["text_card", "three_text_intro", "particle_burst", "shader_transition"]
          },
          "durationInFrames": { "type": "integer", "exclusiveMinimum": 0 }
        }
      }
    }
  }
}
