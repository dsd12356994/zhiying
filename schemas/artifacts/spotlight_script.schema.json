{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spotlight_script.schema.json",
  "title": "Spotlight script (one episode)",
  "description": "Validated LLM output for one project_spotlight cut. The model authors VALUES only; the composition (and therefore the visual quality bar) is the repo's.",
  "type": "object",
  "required": ["index", "total", "name", "stars", "tags", "demoTitle", "subtitle", "brand"],
  "properties": {
    "index": { "type": "integer", "minimum": 1 },
    "total": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 40 },
    "stars": { "type": "integer", "minimum": 0 },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1, "maxLength": 12 }
    },
    "demoTitle": { "type": "string", "minLength": 1, "maxLength": 40 },
    "demoImage": { "type": "string" },
    "demoFooter": { "type": "string", "maxLength": 60 },
    "subtitle": { "type": "string", "minLength": 4, "maxLength": 60 },
    "brand": { "type": "string", "minLength": 1, "maxLength": 20 }
  }
}
