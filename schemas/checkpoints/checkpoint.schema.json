{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "checkpoint.schema.json",
  "title": "Stage checkpoint",
  "type": "object",
  "required": ["project_id", "pipeline", "stage", "status", "written_at"],
  "properties": {
    "project_id": { "type": "string" },
    "pipeline": { "type": "string" },
    "stage": { "type": "string" },
    "status": {
      "enum": ["in_progress", "completed", "awaiting_human", "failed"]
    },
    "written_at": { "type": "string", "format": "date-time" },
    "artifact": { "type": "object" },
    "notes": { "type": "string" }
  }
}
